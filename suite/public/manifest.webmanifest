{
  "name": "OfficeNinja",
  "short_name": "OfficeNinja",
  "description": "Free document, spreadsheet, presentation, and Blueline design editors with local autosave.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#2563eb",
  "icons": [
    {
      "src": "./favicon.svg",
      "sizes": "192x192",
      "type": "image/svg+xml"
    },
    {
      "src": "./favicon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "New document",
      "url": "./#/word"
    },
    {
      "name": "New spreadsheet",
      "url": "./#/excel"
    },
    {
      "name": "New presentation",
      "url": "./#/powerpoint"
    },
    {
      "name": "New Blueline design",
      "url": "./blueline/?new=1"
    }
  ]
}
